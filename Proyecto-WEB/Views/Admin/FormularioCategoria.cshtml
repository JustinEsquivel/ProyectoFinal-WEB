@model ProyectoFinal_WEB.Models.Admin.CategoriaForm
@{ ViewData["Title"] = ViewBag.Id == null ? "Crear categoría" : "Editar categoría"; }

<section class="container py-4">
    <h1>@ViewData["Title"]</h1>

    <form asp-action="GuardarCategoria" asp-route-id="@ViewBag.Id"
          method="post" class="col-lg-7">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Categorias" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</section>