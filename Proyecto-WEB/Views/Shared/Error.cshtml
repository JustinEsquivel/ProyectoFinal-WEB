@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="py-5">
    <div class="container-lg text-center">
        <h2 class="text-danger mb-3">Se presentó un inconveniente técnico</h2>
        <p class="mb-4">Ocurrió un error al procesar su solicitud. Ya quedó registrado; intente nuevamente más tarde.</p>

        @if (Model?.ShowRequestId == true)
        {
            <p class="small text-muted">Código de referencia: <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
    </div>
</section>
