@model IniciarSesionViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutExternal";
}

<partial name="_AuthIcons" />

<section class="auth-form padding-medium">
    <div class="container-lg">
        <div class="row justify-content-evenly align-items-center">
            <div class="col-md-8 col-lg-5 col-xl-4 text-center">
                <h2 class="auth-title">Inicie sesión en su cuenta</h2>
                <p class="my-4">Ingrese su correo y contraseña para continuar.</p>

                @if (TempData["MensajeEstado"] is string mensaje)
                {
                    <div class="alert alert-success text-start" role="alert">@mensaje</div>
                }

                <form asp-action="IniciarSesion" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger text-start"></div>

                    <div class="mb-4 text-start">
                        <div class="position-relative">
                            <input asp-for="Correo" type="email" class="form-control px-5 py-3 shadow-sm" placeholder="Correo electrónico" autocomplete="email">
                            <svg class="auth-icon position-absolute top-50 start-0 translate-middle-y ms-3" width="22" height="22"><use href="#auth-letter" /></svg>
                        </div>
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 text-start">
                        <div class="position-relative">
                            <input asp-for="Contrasena" class="form-control px-5 py-3 shadow-sm" placeholder="Contraseña" autocomplete="current-password">
                            <svg class="auth-icon position-absolute top-50 start-0 translate-middle-y ms-3" width="22" height="22"><use href="#auth-lock" /></svg>
                            <span data-toggle-password="#Contrasena" role="button" aria-label="Mostrar contraseña"
                                  class="eye toggle-password position-absolute top-50 end-0 translate-middle-y me-3"></span>
                        </div>
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end align-items-center my-3">
                        <a asp-action="RecuperarContrasena" class="text-decoration-none text-primary">¿Olvidó su contraseña?</a>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary" type="submit">Iniciar sesión</button>
                    </div>
                </form>

                <p class="mt-4">
                    ¿No tiene una cuenta?
                    <a asp-action="Registro" class="text-decoration-none text-primary">Regístrese aquí</a>
                </p>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <img src="~/images/img-login.jpg" alt="" class="img-fluid">
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account.js" asp-append-version="true"></script>
}
