@model CambiarContrasenaViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<partial name="_AuthIcons" />

<section class="auth-form padding-medium">
    <div class="container-lg">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5 col-xl-4 text-center">
                <h2 class="auth-title">Cambiar contraseña</h2>
                <p class="my-4">Ingrese su contraseña actual y la contraseña nueva.</p>

                @if (TempData["MensajeEstado"] is string mensaje)
                {
                    <div class="alert alert-success text-start" role="alert">@mensaje</div>
                }

                <form asp-action="CambiarContrasena" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger text-start"></div>

                    <div class="mb-4 text-start">
                        <div class="position-relative">
                            <input asp-for="ContrasenaActual" class="form-control px-5 py-3 shadow-sm" placeholder="Contraseña actual" autocomplete="current-password">
                            <svg class="auth-icon position-absolute top-50 start-0 translate-middle-y ms-3" width="22" height="22"><use href="#auth-lock" /></svg>
                            <span data-toggle-password="#ContrasenaActual" role="button" aria-label="Mostrar contraseña"
                                  class="eye toggle-password position-absolute top-50 end-0 translate-middle-y me-3"></span>
                        </div>
                        <span asp-validation-for="ContrasenaActual" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 text-start">
                        <div class="position-relative">
                            <input asp-for="NuevaContrasena" class="form-control px-5 py-3 shadow-sm" placeholder="Contraseña nueva" autocomplete="new-password">
                            <svg class="auth-icon position-absolute top-50 start-0 translate-middle-y ms-3" width="22" height="22"><use href="#auth-lock" /></svg>
                            <span data-toggle-password="#NuevaContrasena" role="button" aria-label="Mostrar contraseña"
                                  class="eye toggle-password position-absolute top-50 end-0 translate-middle-y me-3"></span>
                        </div>
                        <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 text-start">
                        <div class="position-relative">
                            <input asp-for="ConfirmarContrasena" class="form-control px-5 py-3 shadow-sm" placeholder="Confirmar contraseña" autocomplete="new-password">
                            <svg class="auth-icon position-absolute top-50 start-0 translate-middle-y ms-3" width="22" height="22"><use href="#auth-lock" /></svg>
                            <span data-toggle-password="#ConfirmarContrasena" role="button" aria-label="Mostrar contraseña"
                                  class="eye toggle-password position-absolute top-50 end-0 translate-middle-y me-3"></span>
                        </div>
                        <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary" type="submit">Guardar contraseña</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account.js" asp-append-version="true"></script>
}
